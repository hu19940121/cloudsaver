# 服务配置（容器内端口由 Compose 固定为 8009）
NODE_ENV=production
PORT=8009

# JWT 配置。Docker 首次启动时会自动替换为随机密钥
JWT_SECRET=change-me

# 首次启动所需注册码。Docker 会自动生成随机值
ADMIN_REGISTRATION_CODE=
COMMON_REGISTRATION_CODE=

# 可选：额外允许的网页来源，多个来源用英文逗号分隔
PUBLIC_ORIGIN=

# Telegram 公开频道页基础地址
TELEGRAM_BASE_URL=https://t.me/s

# 搜索频道，必须是合法 JSON；也可以登录后由管理员在“设置”中维护
TELE_CHANNELS=[]

# 可选：教父资源站 Cookie，也可以登录后由管理员在“设置”中维护
JIAOFU_COOKIE=

# 图片代理域名白名单，支持精确域名及其子域名
IMAGE_PROXY_ALLOWED_HOSTS=doubanio.com,cdn-telegram.org,telesco.pe,tutu.pm

